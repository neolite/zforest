<form class="reply-form" autocomplete="off" on:submit={ctx.env.act_comment}>
  <input type="hidden" name="post" value={ctx.env.post_str} />
  <input type="hidden" name="parent" value={ctx.num} />
  <input name="text" placeholder="Ответить…" maxlength={ctx.env.max_len} autofocus={true} />
  <button type="submit" class="mini">→</button>
  <button type="button" class="mini cancel" on:click={ctx.env.act_cancel}>×</button>
</form>
